          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training is half of it."
          }
        }
      }
    },
    "Eating enough is the other half.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאכול מספיק זה החצי השני."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eating enough is the other half."
          }
        }
      }
    },
    "SetPoint watches your day and closes the gap between what you ate and what your training needs.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏SetPoint עוקבת אחרי היום שלך וסוגרת את הפער בין מה שאכלת למה שהאימון שלך דורש."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SetPoint watches your day and closes the gap between what you ate and what your training needs."
          }
        }
      }
    },
    "Your day is one line.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היום שלך הוא קו אחד."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your day is one line."
          }
        }
      }
    },
    "See where you should be.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תראה איפה כדאי שתהיה."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See where you should be."
          }
        }
      }
    },
    "The ticks are your meal times and the dots are what you ate. The marker is now. Whatever comes next shows up as a single card.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסימנים הם זמני הארוחות, הנקודות הן מה שאכלת, והמחוון הוא עכשיו. מה שבא אחרי מופיע ככרטיס אחד."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ticks are your meal times and the dots are what you ate. The marker is now. Whatever comes next shows up as a single card."
          }
        }
      }
    },
    "Skipped or light?": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דילגת או אכלת קל?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped or light?"
          }
        }
      }
    },
    "I’ll ask.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני אשאל."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I’ll ask."
          }
        }
      }
    },
    "When a meal is missed or small, I check in. Log it, swap it, or top up with something easy like milk or nuts. In the evening I close what’s left.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשארוחה מתפספסת או קטנה, אני בודק איתך. תרשום אותה, תחליף, או תשלים עם משהו קל כמו חלב או אגוזים. בערב אני סוגר את מה שנשאר."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a meal is missed or small, I check in. Log it, swap it, or top up with something easy like milk or nuts. In the evening I close what’s left."
          }
        }
      }
    },
    "Training moves your plan.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האימון מזיז את התוכנית."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training moves your plan."
          }
        }
      }
    },
    "Add a session, targets rise.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוסיפים אימון, היעדים עולים."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a session, targets rise."
          }
        }
      }
    },
    "Plan your sessions on the Train tab. Tap + any time to log a meal by text, photo or barcode.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תכנן את האימונים בלשונית אימון. לחץ על + בכל רגע כדי לרשום ארוחה בטקסט, בתמונה או בברקוד."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan your sessions on the Train tab. Tap + any time to log a meal by text, photo or barcode."
          }
        }
      }
    },

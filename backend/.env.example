# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# On Vercel, set these same keys in Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

NODE_ENV="development"
PORT="3000"

# Neon POOLED connection string — the host must contain "-pooler".
# neon.tech → your project → Connection Details → "Pooled connection".
DATABASE_URL=""

# Sent by Vercel Cron as `Authorization: Bearer <CRON_SECRET>`, and accepted
# in the `x-cron-secret` header for manual/GitHub-Actions triggering.
# Generate: openssl rand -hex 32
CRON_SECRET=""

# Signs session JWTs. Generate: openssl rand -hex 32
JWT_SECRET=""

# Guards GET /api/admin/metrics (beta tuning dashboard, §8). If left blank the
# endpoint accepts CRON_SECRET instead. Generate: openssl rand -hex 32
ADMIN_SECRET=""

# Shown in the privacy policy / terms footer and the app's support link.
SUPPORT_EMAIL="support@setpoint.app"

# Set to "true" to keep POST /api/auth/dev alive on a deployed (production)
# environment — staging only, never on the real production deploy.
ENABLE_DEV_LOGIN=""

# Sign in with Apple — the app's client id (bundle id, e.g. com.setpoint.app).
# When unset, POST /api/auth/apple returns 501 and POST /api/auth/dev works instead.
APPLE_CLIENT_ID=""

# Sign in with Apple key material — only needed to revoke tokens on account
# deletion (§4). Apple Developer → Keys → a "Sign in with Apple" key (.p8).
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# --- Stubbed until their milestone. Leave blank for now. ---

# AI meal parsing (Haiku) + manager's voice (Sonnet). console.anthropic.com
# When unset, meal logging requires explicit macros and the manager's voice uses
# deterministic fallback copy.
ANTHROPIC_API_KEY=""

# Push delivery — Apple Developer portal → Certificates, IDs & Profiles → Keys
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="com.setpoint.app"
# Paste the full contents of the .p8 file (newlines as literal \n or real newlines)
APNS_PRIVATE_KEY=""

# --- Error reporting ---
# sentry.io → project (Node.js) → Client Keys (DSN). Leave blank to disable.
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/score", "schedule": "0 9 * * *" },
    { "path": "/api/cron/settle", "schedule": "30 8 * * *" }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/privacy", "destination": "/api" },
    { "source": "/terms", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/settle", "schedule": "30 8 * * *" }
  ]
}

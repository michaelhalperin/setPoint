// SetPoint backend data model (milestone 2).
//
// Maps directly to app-plan-animation.md:
//   §2  confidence scoring, check-ins, defer/escalation
//   §3  safety screening (allergies, medical flag, SCOFF)
//   §4  account deletion — every userId FK is onDelete: Cascade
//   §5  onboarding, ledger, prescription, settlement
//
// TimescaleDB is deferred: per §4 raw HRV/RHR never leave the device, so the
// only biosignal data here is a derived deviation the app pushes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Goal {
  BULK
  DIET
  MAINTAIN
}

/// BASIC = no wearable (self-report + meal-gap heuristics).
/// SMART = wearable connected (biosignal deviation feeds scoring).
enum AppMode {
  BASIC
  SMART
}

enum Sex {
  MALE
  FEMALE
  UNSPECIFIED
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum RestrictionSource {
  ALLERGY
  INTOLERANCE
  PREFERENCE
  RELIGIOUS
  MEDICAL
}

/// Why the forcing mechanism is switched off (§3). Null = enforcement allowed.
enum EnforcementDisabledReason {
  MEDICAL_SUPERVISION
  EATING_DISORDER_SCREEN
}

enum CheckInStatus {
  PENDING
  LOGGED
  DEFERRED
  ESCALATED
  EXPIRED
  BACKED_OFF
}

enum MealSource {
  TEXT
  PHOTO
  PRESCRIPTION
  MANUAL
  SAVED
  BARCODE
}

enum PrescriptionStatus {
  OFFERED
  ACCEPTED
  DEFERRED
  SUPERSEDED
}

enum FoodSource {
  CURATED
  USDA
  OPEN_FOOD_FACTS
}

enum DayOutcomeKind {
  ON_TRACK
  UNDER
  OVER
  MISSED
}

enum EscalationOutcome {
  NONE
  ADJUST_PLAN
  DELAY_CHECKINS
  EASE_TARGET
  PAUSE_CHECKINS
  SUGGEST_PROFESSIONAL
  RESUMED
}

/// Whether a check-in notification actually left the server. Misses and
/// escalation only count after SENT / DELIVERED_UNKNOWN / OPENED / ANSWERED.
enum DeliveryStatus {
  CREATED
  SENT
  DELIVERED_UNKNOWN
  FAILED
  OPENED
  ANSWERED
}

enum TargetReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
  UNDONE
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id       String  @id @default(cuid())
  appleSub String? @unique
  email    String? @unique
  timezone String  @default("UTC") // IANA, e.g. "America/New_York"

  /// Sign in with Apple refresh token — stored so account deletion can call
  /// Apple's /auth/revoke (§4). Populated once the auth-code exchange ships.
  appleRefreshToken String?

  /// Closed-beta cohort: fresh HRV/RHR may adjust an already-due check-in.
  /// The kill switch in env still wins — this never independently fires one.
  wearableModifierEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboarding      OnboardingProfile?
  safetyScreening SafetyScreening?
  escalationState EscalationState?
  biosignalState  BiosignalState?

  pushTokens              PushToken[]
  restrictions            DietaryRestriction[]
  meals                   Meal[]
  savedMeals              SavedMeal[]
  weightEntries           WeightEntry[]
  biosignalReadings       BiosignalReading[]
  confidenceScores        ConfidenceScore[]
  checkIns                CheckIn[]
  prescriptions           Prescription[]
  escalationConversations EscalationConversation[]
  dayOutcomes             DayOutcome[]
  aiUsages                AiUsage[]
  targetReviews           WeightTargetReview[]
}

model PushToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token       String @unique
  platform    String @default("ios")
  environment String @default("production") // "production" | "sandbox"
  /// "alert" (a device token for Time Sensitive pushes) or
  /// "live_activity_start" (a push-to-start token for Live Activities).
  kind        String @default("alert")

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, kind])
}

// ---------------------------------------------------------------------------
// Onboarding (§3, §5.1)
// ---------------------------------------------------------------------------

model OnboardingProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal Goal
  mode AppMode @default(BASIC)

  sex           Sex           @default(UNSPECIFIED)
  birthDate     DateTime?     @db.Date
  heightCm      Float?
  weightKg      Float?
  activityLevel ActivityLevel @default(MODERATE)

  // Weight goal (§5.1, M16). BULK/DIET carry a target and a pace; MAINTAIN
  // neither. `paceKgPerWeek` is an unsigned magnitude — direction is the goal.
  // `preferredDurationWeeks` is the user's timeframe; pace is derived from it
  // and then clamped so a short ask never outruns the safety caps.
  startWeightKg           Float?
  targetWeightKg          Float?
  paceKgPerWeek           Float     @default(0.25)
  preferredDurationWeeks  Int?
  goalStartedAt           DateTime?

  // Target snapshot; recomputed when stats, goal, target, or pace change.
  dailyKcalTarget     Int
  dailyProteinTargetG Int?

  // Preferred meal times — minutes from local midnight (defaults 08:00 / 13:00 / 19:00).
  // Feeds expected_gap in the confidence formula (§2).
  breakfastMin Int @default(480)
  lunchMin     Int @default(780)
  dinnerMin    Int @default(1140)

  // Weekend set. Null minutes mean "same as weekdays". weekendDays is a JS-getDay
  // bitmask (bit 0 = Sunday … bit 6 = Saturday); default Sat+Sun = 65.
  weekendBreakfastMin Int?
  weekendLunchMin     Int?
  weekendDinnerMin    Int?
  weekendDays         Int @default(65)

  // Quiet hours — minutes from local midnight (default 23:00–07:00, §2).
  quietHoursStartMin Int @default(1380)
  quietHoursEndMin   Int @default(420)

  /// Foods the user currently has / will eat — solver prefers these.
  pantryTokens  String[] @default([])
  /// Soft dislikes (still not served if listed). Distinct from hard exclusions.
  dislikedFoods String[] @default([])
  prepTimeMaxMin Int?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Safety screening (§3)
// ---------------------------------------------------------------------------

model SafetyScreening {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Conditions requiring supervised nutrition (diabetes, kidney disease, ...).
  medicalSupervisionRequired Boolean @default(false)
  /// Broader medical gate: a condition that affects how they should eat, even
  /// if they are not currently under a clinician. Uncertain answers are stored
  /// as true so enforcement stays off.
  medicalConditionAffectsEating Boolean @default(false)

  // SCOFF — 5 validated yes/no questions.
  scoffMakeSelfSick  Boolean?
  scoffLostControl   Boolean?
  scoffLostOneStone  Boolean? // >14 lb / ~6.35 kg in 3 months
  scoffBelievesFat   Boolean?
  scoffFoodDominates Boolean?
  scoffScore         Int?
  scoffFlagged       Boolean  @default(false) // score >= 2

  // Free-text restrictions; structured ones live in DietaryRestriction.
  restrictionsFreeText String?

  // Derived gate — the confidence engine reads exactly this field.
  enforcementEnabled        Boolean                    @default(true)
  enforcementDisabledReason EnforcementDisabledReason?

  screenedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DietaryRestriction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label           String // as the user entered it: "peanuts", "shellfish"
  token           String // normalized for solver matching: "peanut"
  source          RestrictionSource @default(ALLERGY)
  isHardExclusion Boolean           @default(true)

  createdAt DateTime @default(now())

  @@unique([userId, token])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Weight log (§5.1, M16) — the weekly signal that drives goal progress and the
// auto-switch to MAINTAIN. One entry per measurement; the app sources these
// from a manual weigh-in or a HealthKit body-mass read.
// ---------------------------------------------------------------------------

model WeightEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weightKg   Float
  measuredAt DateTime
  source     String   @default("manual") // "manual" | "healthkit"

  createdAt DateTime @default(now())

  @@unique([userId, measuredAt])
  @@index([userId, measuredAt])
}

// ---------------------------------------------------------------------------
// Meal ledger (§5.5)
// ---------------------------------------------------------------------------

model Meal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  loggedAt DateTime   @default(now())
  source   MealSource

  rawInput        String? // free text or photo caption
  photoUrl        String? // legacy inline data URL — new photos use photoKey
  photoKey        String? // object-storage key (meals/<userId>/<uuid>.jpg), served via a signed URL
  parsedByAI      Boolean @default(false)
  parseConfidence Float?
  /// Assumptions the parser made (portion size, prep).
  notes           String?
  /// Parsed line items: [{ name, quantity, kcal, proteinG, carbsG, fatG }]
  items           Json?
  /// Honest estimate-quality label: "high" | "estimate" | "review".
  parseQuality    String?

  kcal     Int
  proteinG Float @default(0)
  carbsG   Float @default(0)
  fatG     Float @default(0)

  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  checkInId String?
  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  /// Set by the app for each log attempt; a retried request (offline queue,
  /// flaky network) returns the meal already stored instead of a duplicate.
  clientId String?

  createdAt DateTime @default(now())

  @@index([userId, loggedAt])
  @@unique([userId, clientId])
}

/// A named plate the user logs in one tap. Items are a snapshot; totals are
/// derived from them on write so a client cannot send a mismatched target.
model SavedMeal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  /// [{ name, quantity, kcal, proteinG, carbsG, fatG }]
  items Json

  kcal     Int
  proteinG Float @default(0)
  carbsG   Float @default(0)
  fatG     Float @default(0)

  /// "breakfast" | "lunch" | "dinner". Null = no time suggestion.
  suggestSlot   String?
  useInCheckIns Boolean @default(false)

  lastUsedAt DateTime?
  useCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, lastUsedAt])
  @@index([userId, suggestSlot])
}

/// Cached Open Food Facts lookup. Shared across users; the barcode is not a secret.
model BarcodeFood {
  id   String @id @default(cuid())
  code String @unique

  name     String
  brand    String?
  servingG Float?

  kcal100g     Float
  proteinG100g Float
  carbsG100g   Float
  fatG100g     Float

  fetchedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Biosignals (§2, §4) — only derived deviation, never raw HRV/RHR
// ---------------------------------------------------------------------------

model BiosignalState {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hrvDeviation Float // normalized deviation from personal baseline
  rhrDeviation Float?
  source       String // "apple_watch", "oura", "eight_sleep", ...

  updatedAt DateTime @updatedAt
}

model BiosignalReading {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  capturedAt   DateTime
  hrvDeviation Float
  rhrDeviation Float?
  source       String

  createdAt DateTime @default(now())

  @@index([userId, capturedAt])
}

// ---------------------------------------------------------------------------
// Confidence scoring (§2) — deterministic, auditable
// ---------------------------------------------------------------------------

model ConfidenceScore {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  computedAt DateTime @default(now())
  mode       AppMode

  score Float
  scoringVersion String @default("behavior.v2")
  behaviorScore  Float?
  wearableModifier Float?
  wearableUsed     Boolean @default(false)

  // Component inputs retained for auditability + beta tuning (§8).
  biosignalDeviation Float?
  hoursSinceMeal     Float?
  expectedGapHours   Float?
  loggingSilence     Float?
  overdueMin         Float?
  loggingReliability Float?
  deferRate          Float?
  dismissRate        Float?
  targetCoverage     Float?
  components         Json?

  threshold    Float   @default(0.5)
  firedCheckIn Boolean @default(false)
  /// "<local date>:<slot>" — one row per meal episode, updated while it's held.
  episodeKey   String?

  checkIn CheckIn?

  @@index([userId, computedAt])
  @@unique([userId, episodeKey])
}

// ---------------------------------------------------------------------------
// Check-ins + escalation (§2)
// ---------------------------------------------------------------------------

model CheckIn {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  confidenceScoreId String?          @unique
  confidenceScore   ConfidenceScore? @relation(fields: [confidenceScoreId], references: [id], onDelete: SetNull)

  tier   Int           @default(1) // 1 gentle nudge · 2 firm check-in · 3 conversation
  status CheckInStatus @default(PENDING)
  deliveryStatus DeliveryStatus @default(CREATED)

  message String? // manager's-voice copy — deterministic on the critical path
  slot    String? // "breakfast" | "lunch" | "dinner"; null for tier-3

  /// user + local date + slot (+ episode). Prevents duplicate check-ins.
  episodeKey String?

  deliveredAt    DateTime?
  lastPushError  String?
  liveActivityId String?

  deferUntil DateTime?
  deferCount Int       @default(0)

  resolvedAt DateTime?

  // Labeled feedback — thumbs up/down on every check-in (§8).
  feedbackPositive Boolean?
  feedbackAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescription Prescription?
  meals        Meal[]
  conversation EscalationConversation?

  @@unique([userId, episodeKey])
  @@index([userId, status])
  @@index([status, deferUntil])
  @@index([deliveryStatus, status])
}

model EscalationState {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  consecutiveMisses Int       @default(0)
  currentTier       Int       @default(1)
  lastCheckInAt     DateTime?
  backedOffUntil    DateTime? // set after tier 3 — engine stops escalating until this passes
  checkInsPaused    Boolean   @default(false)

  updatedAt DateTime @updatedAt
}

model EscalationConversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  checkInId String?  @unique
  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  transcript Json              @default("[]") // [{ role, content, at }]
  outcome    EscalationOutcome @default(NONE)
  /// Bounded proposal waiting for explicit user confirmation. Never applied
  /// from model prose alone.
  pendingProposal Json?
  appliedProposal Json?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Prescription solver output (§2, §5.4)
// ---------------------------------------------------------------------------

model Prescription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  checkInId String?  @unique
  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  // The macro gap this prescription was solving.
  targetKcal     Int
  targetProteinG Float?

  totalKcal     Int
  totalProteinG Float @default(0)
  totalCarbsG   Float @default(0)
  totalFatG     Float @default(0)

  status PrescriptionStatus @default(OFFERED)

  items PrescriptionItem[]
  meals Meal[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  foodItemId String?
  foodItem   FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  // Snapshot so historical prescriptions stay accurate if the food list changes.
  name     String
  quantity Float
  unit     String
  kcal     Int
  proteinG Float  @default(0)
  carbsG   Float  @default(0)
  fatG     Float  @default(0)

  @@index([prescriptionId])
}

model FoodItem {
  id   String @id @default(cuid())
  slug String @unique

  name         String
  servingDesc  String // "2 large eggs", "1 cup cooked"
  servingGrams Float?

  kcal     Int
  proteinG Float @default(0)
  carbsG   Float @default(0)
  fatG     Float @default(0)

  tags      String[] // "vegetarian", "vegan", "high_protein", "no_cook", "portable"
  allergens String[] // "egg", "dairy", "gluten", "wheat", "peanut", "tree_nut", "soy", "fish", "shellfish", "sesame"

  isStaple   Boolean    @default(true)
  source     FoodSource @default(CURATED)
  externalId String?

  prescriptionItems PrescriptionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Settlement (§5.7)
// ---------------------------------------------------------------------------

model DayOutcome {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date         DateTime       @db.Date // local calendar date
  kind         DayOutcomeKind
  kcalConsumed Int
  kcalTarget   Int
  summaryLine  String? // one manager-voice line, AI-generated (§5.7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ---------------------------------------------------------------------------
// AI usage — per-user quota on the endpoints that call a paid model
// ---------------------------------------------------------------------------

model AiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      String // "meal_parse" | "tier3_message"
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Adaptive target review (Phase 3) — never auto-applied
// ---------------------------------------------------------------------------

model WeightTargetReview {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status          TargetReviewStatus @default(PENDING)
  formulaVersion  String             @default("adapt.v1")
  previousKcal    Int
  proposedKcal    Int
  reason          String
  windowStart     DateTime
  windowEnd       DateTime
  weighInCount    Int
  trendKgPerWeek  Float
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([userId, status, createdAt])
}

model SchedulerHeartbeat {
  job        String   @id
  lastRunAt  DateTime
  lastOk     Boolean
  durationMs Int?
  summary    Json?
}

// ---------------------------------------------------------------------------
// Object-storage cleanup
// ---------------------------------------------------------------------------

/// A photo delete that failed (storage hiccup), retried by the daily cron.
/// No user relation on purpose: account deletion must leave these behind.
model PendingPhotoDeletion {
  id          String    @id @default(cuid())
  /// "object" — a single photo key; "user" — every photo under a deleted user's prefix.
  kind        String
  /// The object key, or the user id for kind "user".
  target      String
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  lastTriedAt DateTime?

  @@unique([kind, target])
  @@index([attempts, createdAt])
}

/// Shared fixed-window request counter (auth endpoints), pruned daily.
model RateLimitBucket {
  /// "<scope>:<client>:<window start ms>"
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime

  @@index([windowEnd])
}
